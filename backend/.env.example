# Server Configuration
PORT=8080

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=military_asset_db
DB_URL=jdbc:mysql://localhost:3306/military_asset_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

# JPA / Hibernate Configuration
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Security / JWT Configuration
JWT_SECRET=replace_with_secure_secret
JWT_EXPIRATION_MS=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

